<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Codeberg #28: only the splash background may follow the system night
         mode. The window chrome colors (chompass_background, status/nav bar,
         primary accents) deliberately do NOT get night variants: the XML theme
         is mode-neutral light so the window layer can never contradict the
         in-app Appearance setting (Light/Dark/System). The Compose theme draws
         the actual mode; this file only feeds the pre-Compose splash. -->
    <color name="app_splash_background">#FF170E16</color>

    <!-- Notification shade colors (Codeberg #169), not the app appearance. -->
    <color name="notification_ongoing_title">#FFE6E1E5</color>
    <color name="notification_ongoing_secondary">#FFCAC4D0</color>
    <color name="notification_ongoing_protein">#FFA8C7FA</color>
    <color name="notification_ongoing_carbs">#FFFFD27A</color>
    <color name="notification_ongoing_fat">#FFFFB3C7</color>
</resources>
