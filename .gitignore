# Build outputs
build/
.gradle/
.cxx/
*.iml
.idea/
.DS_Store

# Local SDK config and signing material (never commit)
local.properties
android/keystore.properties
android/secrets.properties
android/secrets.properties.*
*.jks
.env.local

# devenv
.devenv/
.devenv.flake.nix
.android/

# Local maintainer notes (not published)
docs/local/
docs/archive/

# Local Codeberg workflow tooling (issue/PR templates ARE published from .forgejo/)
.forgejo/*
!.forgejo/issue_template/
!.forgejo/pull_request_template.md

# Personal health-data exports (dated names rotate)
Fud-Food-Diary-*.json
FudAI-Weight-Import.*

# Release artifacts (published on Codeberg Releases)
/*.apk
SHA256SUMS
releases/
release-screenshots/

# Local dev screenshots (adb captures, not published)
/screenshots/

# On-device LLM debug fixtures (personal photos; regenerate via scripts/prepare_ondevice_llm_fixtures.py)
android/app/src/debug/assets/ondevice_llm/

# Benchmark data caches and raw dataset downloads (code and manifests stay tracked)
docs/benchmarks/*/data/
docs/benchmarks/*/results/
docs/benchmarks/food_accuracy/manifest/fndds_generated*.jsonl
build/usda-fdc/
build/swiss-sfdc/

# Python
__pycache__/
*.pyc

# Hugo project site (Codeberg Pages)
website/public/
website/resources/
website/.hugo_build.lock

# Kotlin compiler session junk (Kotlin 2.x writes here during builds)
android/.kotlin/

