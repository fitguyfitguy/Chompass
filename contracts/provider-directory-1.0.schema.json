{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chompass.app/contracts/provider-directory-1.0.schema.json",
  "title": "Chompass bundled provider directory 1.0",
  "description": "Reviewed OpenAI-compatible endpoints bundled with each release (Codeberg #143). Generated by scripts/generate_provider_directory.py from https://models.dev/api.json; validated in release:check-parity and consumed by the Android Custom base-URL sheet. Entry-level uniqueness of id/baseUrl is enforced by the generator and ProviderDirectoryAssetTest, not by JSON Schema.",
  "type": "object",
  "required": ["version", "source", "fetchedAt", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "source": { "const": "https://models.dev/api.json" },
    "fetchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "baseUrl", "docsUrl", "visionModels"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 60 },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "baseUrl": { "type": "string", "pattern": "^https://" },
          "docsUrl": { "type": "string", "pattern": "^https://" },
          "visionModels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      }
    }
  }
}
