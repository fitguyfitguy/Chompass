{
  "version": 1,
  "notes": "Shared UI locale contract for Android resource packs and the PWA i18n catalog. Speech recognition languages are independent (see speechLocales). Pref key: Android system/per-app language; PWA prefs.uiLang (empty = auto-detect browser). Fallback always English (en).",
  "defaultLocale": "en",
  "fallbackLocale": "en",
  "pwaPrefKey": "uiLang",
  "locales": [
    { "id": "en", "bcp47": "en", "androidValues": "values", "name": "English", "nativeName": "English", "rtl": false, "speechCodes": ["en", "en-US", "en-GB"] },
    { "id": "ar", "bcp47": "ar", "androidValues": "values-ar", "name": "Arabic", "nativeName": "العربية", "rtl": true, "speechCodes": ["ar"] },
    { "id": "az", "bcp47": "az", "androidValues": "values-az", "name": "Azerbaijani", "nativeName": "Azərbaycan", "rtl": false, "speechCodes": ["az"] },
    { "id": "de", "bcp47": "de", "androidValues": "values-de", "name": "German", "nativeName": "Deutsch", "rtl": false, "speechCodes": ["de", "de-DE"] },
    { "id": "es", "bcp47": "es", "androidValues": "values-es", "name": "Spanish", "nativeName": "Español", "rtl": false, "speechCodes": ["es", "es-ES"] },
    { "id": "fr", "bcp47": "fr", "androidValues": "values-fr", "name": "French", "nativeName": "Français", "rtl": false, "speechCodes": ["fr", "fr-FR"] },
    { "id": "hi", "bcp47": "hi", "androidValues": "values-hi", "name": "Hindi", "nativeName": "हिन्दी", "rtl": false, "speechCodes": ["hi", "hi-IN"] },
    { "id": "it", "bcp47": "it", "androidValues": "values-it", "name": "Italian", "nativeName": "Italiano", "rtl": false, "speechCodes": ["it", "it-IT"] },
    { "id": "ja", "bcp47": "ja", "androidValues": "values-ja", "name": "Japanese", "nativeName": "日本語", "rtl": false, "speechCodes": ["ja", "ja-JP"] },
    { "id": "ko", "bcp47": "ko", "androidValues": "values-ko", "name": "Korean", "nativeName": "한국어", "rtl": false, "speechCodes": ["ko", "ko-KR"] },
    { "id": "nl", "bcp47": "nl", "androidValues": "values-nl", "name": "Dutch", "nativeName": "Nederlands", "rtl": false, "speechCodes": ["nl", "nl-NL"] },
    { "id": "pt-BR", "bcp47": "pt-BR", "androidValues": "values-pt-rBR", "name": "Portuguese (Brazil)", "nativeName": "Português (Brasil)", "rtl": false, "speechCodes": ["pt", "pt-BR"] },
    { "id": "ro", "bcp47": "ro", "androidValues": "values-ro", "name": "Romanian", "nativeName": "Română", "rtl": false, "speechCodes": ["ro", "ro-RO"] },
    { "id": "ru", "bcp47": "ru", "androidValues": "values-ru", "name": "Russian", "nativeName": "Русский", "rtl": false, "speechCodes": ["ru", "ru-RU"] },
    { "id": "zh-CN", "bcp47": "zh-CN", "androidValues": "values-zh-rCN", "name": "Chinese (Simplified)", "nativeName": "简体中文", "rtl": false, "speechCodes": ["zh", "zh-CN"] }
  ],
  "speechLocales": {
    "notes": "Speech recognition language is independent of UI locale. Empty/auto uses device or provider detection.",
    "pwa": ["", "en-US", "en-GB", "de-DE", "fr-FR", "es-ES", "it-IT", "nl-NL", "pt-BR", "hi-IN", "ja-JP", "zh-CN", "ko-KR", "sv-SE"],
